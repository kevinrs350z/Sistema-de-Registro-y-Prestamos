<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Sistema de Reserva - Diseño Multimedia"
                  exporterVersion="2.0">

  <bpmn:collaboration id="Collaboration_Prestamo">
    <bpmn:participant id="Pool_Alumno" name="Alumno" processRef="Process_Alumno" />
    <bpmn:participant id="Pool_Admin" name="Administrador" processRef="Process_Admin" />

    <bpmn:messageFlow id="MF_01" name="Solicitud de préstamo" sourceRef="Task_A_Enviar" targetRef="Event_B_RecibeSolicitud" />
    <bpmn:messageFlow id="MF_02" name="Email: Confirmación de solicitud" sourceRef="Task_B_EmailConfirmacion" targetRef="Event_A_RecibeConfirmacion" />
    <bpmn:messageFlow id="MF_03" name="Email: Préstamo aprobado" sourceRef="Task_B_EmailAprobado" targetRef="Event_A_Aprobado" />
    <bpmn:messageFlow id="MF_04" name="Email: Préstamo rechazado" sourceRef="Task_B_EmailRechazado" targetRef="Event_A_Rechazado" />
    <bpmn:messageFlow id="MF_05" name="Alumno se presenta a retirar" sourceRef="Task_A_Presentarse" targetRef="Event_B_AlumnoPresente" />
    <bpmn:messageFlow id="MF_06" name="Email: Equipos entregados" sourceRef="Task_B_EmailEntregado" targetRef="Event_A_Entregado" />
    <bpmn:messageFlow id="MF_07" name="Alumno devuelve equipos" sourceRef="Task_A_Devolver" targetRef="Event_B_RecibeDev" />
    <bpmn:messageFlow id="MF_08" name="Email: Devolución confirmada" sourceRef="Task_B_EmailDevuelto" targetRef="Event_A_Devuelto" />
  </bpmn:collaboration>

  <!-- ======================================================== -->
  <!--  POOL: ALUMNO                                            -->
  <!-- ======================================================== -->
  <bpmn:process id="Process_Alumno" name="Flujo del Alumno" isExecutable="false">

    <bpmn:startEvent id="Start_A" name="Necesita equipos">
      <bpmn:outgoing>F_A01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="GW_A_Bloqueado" name="¿Bloqueado o sancionado?">
      <bpmn:incoming>F_A01</bpmn:incoming>
      <bpmn:outgoing>F_A02_Si</bpmn:outgoing>
      <bpmn:outgoing>F_A02_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_A_Bloqueado" name="Acceso denegado">
      <bpmn:incoming>F_A02_Si</bpmn:incoming>
      <bpmn:terminateEventDefinition />
    </bpmn:endEvent>

    <bpmn:userTask id="Task_A_Catalogo" name="Explorar catálogo de equipos&#10;(Fotografía, Audiovisual, Iluminación, Computacional, Packs)">
      <bpmn:incoming>F_A02_No</bpmn:incoming>
      <bpmn:outgoing>F_A03</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_A_Carrito" name="Seleccionar equipos al carrito&#10;(cantidad, modo: cualquiera / específico)">
      <bpmn:incoming>F_A03</bpmn:incoming>
      <bpmn:outgoing>F_A04</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="Task_A_Formulario" name="Completar formulario:&#10;• Tipo: DENTRO / FUERA&#10;• Horarios o Fechas&#10;• Asignatura&#10;• Proyecto grupal (opcional)&#10;• Observación&#10;• Aceptar T&amp;C">
      <bpmn:incoming>F_A04</bpmn:incoming>
      <bpmn:outgoing>F_A05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sendTask id="Task_A_Enviar" name="Enviar solicitud">
      <bpmn:incoming>F_A05</bpmn:incoming>
      <bpmn:outgoing>F_A06</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_A_RecibeConfirmacion" name="Recibe confirmación por email">
      <bpmn:incoming>F_A06</bpmn:incoming>
      <bpmn:outgoing>F_A07</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_A01" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_A_Esperar" name="Esperar respuesta del administrador">
      <bpmn:incoming>F_A07</bpmn:incoming>
      <bpmn:outgoing>F_A08</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:eventBasedGateway id="GW_A_Respuesta" name="Respuesta recibida">
      <bpmn:incoming>F_A08</bpmn:incoming>
      <bpmn:outgoing>F_A09_Apr</bpmn:outgoing>
      <bpmn:outgoing>F_A09_Rech</bpmn:outgoing>
    </bpmn:eventBasedGateway>

    <bpmn:intermediateCatchEvent id="Event_A_Aprobado" name="Recibe email: Aprobado">
      <bpmn:incoming>F_A09_Apr</bpmn:incoming>
      <bpmn:outgoing>F_A10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_A02" />
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="Event_A_Rechazado" name="Recibe email: Rechazado (con motivo)">
      <bpmn:incoming>F_A09_Rech</bpmn:incoming>
      <bpmn:outgoing>F_A_Fin_Rech</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_A03" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_A_Rechazado" name="Solicitud rechazada">
      <bpmn:incoming>F_A_Fin_Rech</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sendTask id="Task_A_Presentarse" name="Presentarse a retirar equipos en el laboratorio">
      <bpmn:incoming>F_A10</bpmn:incoming>
      <bpmn:outgoing>F_A11</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_A_Entregado" name="Recibe email: Equipos entregados">
      <bpmn:incoming>F_A11</bpmn:incoming>
      <bpmn:outgoing>F_A12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_A04" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_A_Usar" name="Usar equipos (en lab o externo)">
      <bpmn:incoming>F_A12</bpmn:incoming>
      <bpmn:outgoing>F_A13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sendTask id="Task_A_Devolver" name="Devolver equipos al laboratorio">
      <bpmn:incoming>F_A13</bpmn:incoming>
      <bpmn:outgoing>F_A14</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_A_Devuelto" name="Recibe email: Devolución confirmada">
      <bpmn:incoming>F_A14</bpmn:incoming>
      <bpmn:outgoing>F_A_Fin</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_A05" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="End_A_Ok" name="Préstamo finalizado">
      <bpmn:incoming>F_A_Fin</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_A01" sourceRef="Start_A" targetRef="GW_A_Bloqueado" />
    <bpmn:sequenceFlow id="F_A02_Si" name="Sí" sourceRef="GW_A_Bloqueado" targetRef="End_A_Bloqueado" />
    <bpmn:sequenceFlow id="F_A02_No" name="No" sourceRef="GW_A_Bloqueado" targetRef="Task_A_Catalogo" />
    <bpmn:sequenceFlow id="F_A03" sourceRef="Task_A_Catalogo" targetRef="Task_A_Carrito" />
    <bpmn:sequenceFlow id="F_A04" sourceRef="Task_A_Carrito" targetRef="Task_A_Formulario" />
    <bpmn:sequenceFlow id="F_A05" sourceRef="Task_A_Formulario" targetRef="Task_A_Enviar" />
    <bpmn:sequenceFlow id="F_A06" sourceRef="Task_A_Enviar" targetRef="Event_A_RecibeConfirmacion" />
    <bpmn:sequenceFlow id="F_A07" sourceRef="Event_A_RecibeConfirmacion" targetRef="Task_A_Esperar" />
    <bpmn:sequenceFlow id="F_A08" sourceRef="Task_A_Esperar" targetRef="GW_A_Respuesta" />
    <bpmn:sequenceFlow id="F_A09_Apr" sourceRef="GW_A_Respuesta" targetRef="Event_A_Aprobado" />
    <bpmn:sequenceFlow id="F_A09_Rech" sourceRef="GW_A_Respuesta" targetRef="Event_A_Rechazado" />
    <bpmn:sequenceFlow id="F_A_Fin_Rech" sourceRef="Event_A_Rechazado" targetRef="End_A_Rechazado" />
    <bpmn:sequenceFlow id="F_A10" sourceRef="Event_A_Aprobado" targetRef="Task_A_Presentarse" />
    <bpmn:sequenceFlow id="F_A11" sourceRef="Task_A_Presentarse" targetRef="Event_A_Entregado" />
    <bpmn:sequenceFlow id="F_A12" sourceRef="Event_A_Entregado" targetRef="Task_A_Usar" />
    <bpmn:sequenceFlow id="F_A13" sourceRef="Task_A_Usar" targetRef="Task_A_Devolver" />
    <bpmn:sequenceFlow id="F_A14" sourceRef="Task_A_Devolver" targetRef="Event_A_Devuelto" />
    <bpmn:sequenceFlow id="F_A_Fin" sourceRef="Event_A_Devuelto" targetRef="End_A_Ok" />
  </bpmn:process>

  <!-- ======================================================== -->
  <!--  POOL: ADMINISTRADOR                                     -->
  <!-- ======================================================== -->
  <bpmn:process id="Process_Admin" name="Flujo del Administrador" isExecutable="false">

    <bpmn:startEvent id="Event_B_RecibeSolicitud" name="Recibe solicitud de préstamo">
      <bpmn:outgoing>F_B01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_B01" />
    </bpmn:startEvent>

    <bpmn:sendTask id="Task_B_EmailConfirmacion" name="Enviar email de confirmación al alumno">
      <bpmn:incoming>F_B01</bpmn:incoming>
      <bpmn:outgoing>F_B02</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:userTask id="Task_B_Revisar" name="Revisar solicitud&#10;(datos del alumno, equipos, fechas, asignatura)">
      <bpmn:incoming>F_B02</bpmn:incoming>
      <bpmn:outgoing>F_B03</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_B_Ajustar" name="¿Necesita ajustar equipos?">
      <bpmn:incoming>F_B03</bpmn:incoming>
      <bpmn:outgoing>F_B04_Si</bpmn:outgoing>
      <bpmn:outgoing>F_B04_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_B_Ajustar" name="Ajustar equipos asignados">
      <bpmn:incoming>F_B04_Si</bpmn:incoming>
      <bpmn:outgoing>F_B05</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_B_MergeAjustar">
      <bpmn:incoming>F_B04_No</bpmn:incoming>
      <bpmn:incoming>F_B05</bpmn:incoming>
      <bpmn:outgoing>F_B06</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="GW_B_Decision" name="¿Aprobar o rechazar?">
      <bpmn:incoming>F_B06</bpmn:incoming>
      <bpmn:outgoing>F_B07_Apr</bpmn:outgoing>
      <bpmn:outgoing>F_B07_Rech</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- RAMA RECHAZAR -->
    <bpmn:userTask id="Task_B_MotivoRechazo" name="Indicar motivo de rechazo:&#10;• Sin stock&#10;• Conflicto de horario&#10;• Sanción activa&#10;• Documentación incompleta&#10;• Límite de préstamos&#10;• Otro">
      <bpmn:incoming>F_B07_Rech</bpmn:incoming>
      <bpmn:outgoing>F_B08_Rech</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_B_LibEquipos" name="Liberar equipos (estado → Disponible)">
      <bpmn:incoming>F_B08_Rech</bpmn:incoming>
      <bpmn:outgoing>F_B09_Rech</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_B_EmailRechazado" name="Enviar email de rechazo al alumno (con motivo)">
      <bpmn:incoming>F_B09_Rech</bpmn:incoming>
      <bpmn:outgoing>F_B_FinRech</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_B_Rechazado" name="Solicitud rechazada">
      <bpmn:incoming>F_B_FinRech</bpmn:incoming>
    </bpmn:endEvent>

    <!-- RAMA APROBAR -->
    <bpmn:sendTask id="Task_B_EmailAprobado" name="Enviar email de aprobación al alumno">
      <bpmn:incoming>F_B07_Apr</bpmn:incoming>
      <bpmn:outgoing>F_B08_Apr</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_B_AlumnoPresente" name="Alumno se presenta a retirar">
      <bpmn:incoming>F_B08_Apr</bpmn:incoming>
      <bpmn:outgoing>F_B09_Apr</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_B02" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_B_Entregar" name="Verificar identidad y entregar equipos físicamente">
      <bpmn:incoming>F_B09_Apr</bpmn:incoming>
      <bpmn:outgoing>F_B10</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:sendTask id="Task_B_EmailEntregado" name="Enviar email de entrega al alumno">
      <bpmn:incoming>F_B10</bpmn:incoming>
      <bpmn:outgoing>F_B11</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:intermediateCatchEvent id="Event_B_RecibeDev" name="Alumno devuelve equipos">
      <bpmn:incoming>F_B11</bpmn:incoming>
      <bpmn:incoming>F_B_VolverEspera</bpmn:incoming>
      <bpmn:outgoing>F_B12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_B03" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="Task_B_Verificar" name="Verificar estado de los equipos">
      <bpmn:incoming>F_B12</bpmn:incoming>
      <bpmn:outgoing>F_B13</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="GW_B_TipoDev" name="¿Devolución completa?">
      <bpmn:incoming>F_B13</bpmn:incoming>
      <bpmn:outgoing>F_B14_Completa</bpmn:outgoing>
      <bpmn:outgoing>F_B14_Parcial</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="Task_B_DevParcial" name="Registrar devolución parcial (marcar equipos devueltos)">
      <bpmn:incoming>F_B14_Parcial</bpmn:incoming>
      <bpmn:outgoing>F_B_VolverEspera</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="Task_B_LibTodos" name="Liberar todos los equipos (estado → Disponible)">
      <bpmn:incoming>F_B14_Completa</bpmn:incoming>
      <bpmn:outgoing>F_B15</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:sendTask id="Task_B_EmailDevuelto" name="Enviar email de devolución al alumno">
      <bpmn:incoming>F_B15</bpmn:incoming>
      <bpmn:outgoing>F_B_Fin</bpmn:outgoing>
    </bpmn:sendTask>

    <bpmn:endEvent id="End_B_Ok" name="Préstamo finalizado">
      <bpmn:incoming>F_B_Fin</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_B01" sourceRef="Event_B_RecibeSolicitud" targetRef="Task_B_EmailConfirmacion" />
    <bpmn:sequenceFlow id="F_B02" sourceRef="Task_B_EmailConfirmacion" targetRef="Task_B_Revisar" />
    <bpmn:sequenceFlow id="F_B03" sourceRef="Task_B_Revisar" targetRef="GW_B_Ajustar" />
    <bpmn:sequenceFlow id="F_B04_Si" name="Sí" sourceRef="GW_B_Ajustar" targetRef="Task_B_Ajustar" />
    <bpmn:sequenceFlow id="F_B04_No" name="No" sourceRef="GW_B_Ajustar" targetRef="GW_B_MergeAjustar" />
    <bpmn:sequenceFlow id="F_B05" sourceRef="Task_B_Ajustar" targetRef="GW_B_MergeAjustar" />
    <bpmn:sequenceFlow id="F_B06" sourceRef="GW_B_MergeAjustar" targetRef="GW_B_Decision" />
    <bpmn:sequenceFlow id="F_B07_Apr" name="Aprobar" sourceRef="GW_B_Decision" targetRef="Task_B_EmailAprobado" />
    <bpmn:sequenceFlow id="F_B07_Rech" name="Rechazar" sourceRef="GW_B_Decision" targetRef="Task_B_MotivoRechazo" />
    <bpmn:sequenceFlow id="F_B08_Rech" sourceRef="Task_B_MotivoRechazo" targetRef="Task_B_LibEquipos" />
    <bpmn:sequenceFlow id="F_B09_Rech" sourceRef="Task_B_LibEquipos" targetRef="Task_B_EmailRechazado" />
    <bpmn:sequenceFlow id="F_B_FinRech" sourceRef="Task_B_EmailRechazado" targetRef="End_B_Rechazado" />
    <bpmn:sequenceFlow id="F_B08_Apr" sourceRef="Task_B_EmailAprobado" targetRef="Event_B_AlumnoPresente" />
    <bpmn:sequenceFlow id="F_B09_Apr" sourceRef="Event_B_AlumnoPresente" targetRef="Task_B_Entregar" />
    <bpmn:sequenceFlow id="F_B10" sourceRef="Task_B_Entregar" targetRef="Task_B_EmailEntregado" />
    <bpmn:sequenceFlow id="F_B11" sourceRef="Task_B_EmailEntregado" targetRef="Event_B_RecibeDev" />
    <bpmn:sequenceFlow id="F_B12" sourceRef="Event_B_RecibeDev" targetRef="Task_B_Verificar" />
    <bpmn:sequenceFlow id="F_B13" sourceRef="Task_B_Verificar" targetRef="GW_B_TipoDev" />
    <bpmn:sequenceFlow id="F_B14_Completa" name="Sí, completa" sourceRef="GW_B_TipoDev" targetRef="Task_B_LibTodos" />
    <bpmn:sequenceFlow id="F_B14_Parcial" name="No, parcial" sourceRef="GW_B_TipoDev" targetRef="Task_B_DevParcial" />
    <bpmn:sequenceFlow id="F_B_VolverEspera" sourceRef="Task_B_DevParcial" targetRef="Event_B_RecibeDev" />
    <bpmn:sequenceFlow id="F_B15" sourceRef="Task_B_LibTodos" targetRef="Task_B_EmailDevuelto" />
    <bpmn:sequenceFlow id="F_B_Fin" sourceRef="Task_B_EmailDevuelto" targetRef="End_B_Ok" />
  </bpmn:process>

  <!-- ======================================================== -->
  <!--  DIAGRAMA VISUAL                                         -->
  <!-- ======================================================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Prestamo">

      <!-- POOL ALUMNO -->
      <bpmndi:BPMNShape id="Pool_Alumno_di" bpmnElement="Pool_Alumno" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2640" height="350" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_A_di" bpmnElement="Start_A">
        <dc:Bounds x="222" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_A_Bloqueado_di" bpmnElement="GW_A_Bloqueado" isMarkerVisible="true">
        <dc:Bounds x="305" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_A_Bloqueado_di" bpmnElement="End_A_Bloqueado">
        <dc:Bounds x="312" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_Catalogo_di" bpmnElement="Task_A_Catalogo">
        <dc:Bounds x="410" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_Carrito_di" bpmnElement="Task_A_Carrito">
        <dc:Bounds x="560" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_Formulario_di" bpmnElement="Task_A_Formulario">
        <dc:Bounds x="710" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_Enviar_di" bpmnElement="Task_A_Enviar">
        <dc:Bounds x="860" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_A_RecibeConfirmacion_di" bpmnElement="Event_A_RecibeConfirmacion">
        <dc:Bounds x="1012" y="212" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_Esperar_di" bpmnElement="Task_A_Esperar">
        <dc:Bounds x="1100" y="190" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_A_Respuesta_di" bpmnElement="GW_A_Respuesta">
        <dc:Bounds x="1255" y="205" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_A_Aprobado_di" bpmnElement="Event_A_Aprobado">
        <dc:Bounds x="1362" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_A_Rechazado_di" bpmnElement="Event_A_Rechazado">
        <dc:Bounds x="1362" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_A_Rechazado_di" bpmnElement="End_A_Rechazado">
        <dc:Bounds x="1452" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_Presentarse_di" bpmnElement="Task_A_Presentarse">
        <dc:Bounds x="1460" y="120" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_A_Entregado_di" bpmnElement="Event_A_Entregado">
        <dc:Bounds x="1612" y="142" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_Usar_di" bpmnElement="Task_A_Usar">
